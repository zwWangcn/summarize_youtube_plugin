# Optional override for the UI test-build badge.
# npm run dev / npm run build:test show the badge by default.
# npm run build hides it by default.
# Copy this file to .env.local and uncomment ONE setting to override:
# VITE_TEST_BUILD=true
# VITE_TEST_BUILD=false
# Never store API keys in VITE_* variables: they are public build-time values.
